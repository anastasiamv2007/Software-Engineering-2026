<UserControl x:Class="SoftwareEngineering.Client.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F8F9FA" Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Ліва панель: Список проєктів -->
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <!-- Права панель: Єдиний робочий простір (CRUD) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛІВА ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Пул проєктів" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                <Button Grid.Row="1" x:Name="BtnCreateNew" Content="+ Створити проєкт" 
                        Height="38" Background="#27AE60" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Click="BtnCreateNew_Click" Margin="0,0,0,15"/>

                <ListBox Grid.Row="2" x:Name="LstProjects" 
                         SelectionChanged="LstProjects_SelectionChanged"
                         DisplayMemberPath="Name"
                         BorderThickness="0" Background="Transparent"/>
            </Grid>
        </Border>

        <!-- ПРАВА ПАНЕЛЬ -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="25">
            <Grid x:Name="DetailsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtHeader" Text="Редагування проєкту" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Text="Назва проєкту:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtProjectName" Height="36" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Кількість тасків: " Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtTasksCount" Text="0" FontWeight="Bold" Foreground="#2C3E50" Margin="5,0,20,0"/>

                    <TextBlock Text="Створено: " Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtCreatedAt" Text="-" FontWeight="Bold" Foreground="#2C3E50" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- ПАНЕЛЬ ДОДАВАННЯ СПІВВИКОНАВЦЯ -->
                <StackPanel Grid.Row="3" x:Name="CoExecutorPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="Додати співвиконавця (Email):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCoExecutorEmail" Grid.Column="0" Height="36" VerticalContentAlignment="Center" Padding="8,0" FontSize="14" Margin="0,0,10,0"/>
                        <Button x:Name="BtnAddCoExecutor" Grid.Column="1" Content="Додати" Width="100" Height="36" 
                                Background="#27AE60" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                Click="BtnAddCoExecutor_Click"/>
                    </Grid>
                </StackPanel>

                <!-- СПИСОК УЧАСНИКІВ ПРОЄКТУ ТА ЗМІНА РОЛІ -->
                <Grid Grid.Row="4" x:Name="MembersPanel" Margin="0,20,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Учасники проєкту:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                    <Border Grid.Row="1" BorderBrush="#E0E6ED" BorderThickness="1" CornerRadius="6" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LstMembers">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F2F5" BorderThickness="0,0,0,1" Padding="6,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                                    <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#7F8C8D"/>
                                                </StackPanel>

                                                <!-- Випадаючий список ролі (доступний лише Owner для не-Owner учасників) -->
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableRoles}"
                                                          DisplayMemberPath="Title"
                                                          SelectedValuePath="Role"
                                                          SelectedValue="{Binding Role, Mode=OneWay}"
                                                          Visibility="{Binding ComboVisibility}"
                                                          Height="30"
                                                          VerticalContentAlignment="Center"
                                                          SelectionChanged="CmbMemberRole_SelectionChanged"/>

                                                <!-- Текстовий підпис ролі (для самого Owner або коли поточний користувач не Owner) -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RoleDisplay}"
                                                           Visibility="{Binding TextVisibility}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           FontWeight="SemiBold"
                                                           Foreground="#5D6D7E"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- КНОПКИ ЗБЕРЕЖЕННЯ / ВИДАЛЕННЯ -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnDelete" Content="Видалити" Width="100" Height="36" 
                            Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand" 
                            Click="BtnDelete_Click" Margin="0,0,10,0"/>

                    <Button x:Name="BtnSave" Content="Зберегти" Width="120" Height="36" 
                            Background="#2980B9" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" 
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>