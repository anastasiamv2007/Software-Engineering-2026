<UserControl x:Class="SoftwareEngineering.Client.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F8F9FA" Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Ліва панель: Список проєктів -->
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <!-- Права панель: Єдиний робочий простір (CRUD) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛІВА ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Пул проєктів" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                <Button Grid.Row="1" x:Name="BtnCreateNew" Content="+ Створити проєкт" 
                        Height="38" Background="#27AE60" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Click="BtnCreateNew_Click" Margin="0,0,0,15"/>

                <ListBox Grid.Row="2" x:Name="LstProjects" 
                         SelectionChanged="LstProjects_SelectionChanged"
                         DisplayMemberPath="Name"
                         BorderThickness="0" Background="Transparent"/>
            </Grid>
        </Border>

        <!-- ПРАВА ПАНЕЛЬ -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="25">
            <Grid x:Name="DetailsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtHeader" Text="Редагування проєкту" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Text="Назва проєкту:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtProjectName" Height="36" VerticalContentAlignment="Center" Padding="8,0" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Кількість тасків: " Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtTasksCount" Text="0" FontWeight="Bold" Foreground="#2C3E50" Margin="5,0,20,0"/>

                    <TextBlock Text="Створено: " Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtCreatedAt" Text="-" FontWeight="Bold" Foreground="#2C3E50" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- ПАНЕЛЬ ЗАВДАНЬ -->
                <Grid Grid.Row="3" x:Name="TaskSection" Margin="0,10,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Завдання проєкту:" FontWeight="Bold" FontSize="16" Foreground="#2C3E50" Margin="0,0,0,10"/>

                    <!-- Швидке додавання таски -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNewTaskTitle" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="13" />
                        <Button Grid.Column="1" x:Name="BtnCreateTask" Content="+ Додати" Width="90" Height="34" Margin="10,0,0,0"
                                Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCreateTask_Click"/>
                    </Grid>

                    <!-- Список тасок -->
                    <ListBox Grid.Row="2" x:Name="LstTasks" BorderThickness="1" BorderBrush="#E0E0E0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,8" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Deadline, StringFormat=dd.MM.yyyy}" Foreground="#7F8C8D" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="🗑" Width="30" Height="30" Margin="10,0,10,0"
                                            Background="Transparent" Foreground="#E74C3C" BorderThickness="0" Cursor="Hand" FontSize="16"
                                            Tag="{Binding Id}" Click="BtnDeleteTask_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnDelete" Content="Видалити" Width="100" Height="36" 
                            Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand" 
                            Click="BtnDelete_Click" Margin="0,0,10,0"/>

                    <Button x:Name="BtnSave" Content="Зберегти" Width="120" Height="36" 
                            Background="#2980B9" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" 
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>