<Window x:Class="SoftwareEngineering.Client.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:SoftwareEngineering.DAL.Enums;assembly=SoftwareEngineering.DAL"
        Title="Оновлення прогресу завдання" Height="320" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ідентифікатор завдання *" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" x:Name="TaskIdTextBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Ідентифікатор співвиконавця *" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" x:Name="UserIdTextBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Новий статус *" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="5" x:Name="StatusComboBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15">
            <ComboBoxItem Content="В роботі" Tag="{x:Static enums:TaskItemStatus.InProgress}" IsSelected="True"/>
            <ComboBoxItem Content="Виконано" Tag="{x:Static enums:TaskItemStatus.Done}"/>
        </ComboBox>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Скасувати" Width="90" Height="30" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Оновити" Width="110" Height="30" Click="UpdateButton_Click" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>