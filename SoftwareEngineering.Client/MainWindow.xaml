<Window x:Class="SoftwareEngineering.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:SoftwareEngineering.DAL.Enums;assembly=SoftwareEngineering.DAL"
        xmlns:local="clr-namespace:SoftwareEngineering.Client"
        Title="PLANORA" Height="800" Width="1280" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">

    <Window.Resources>
        <!-- Стиль кнопок бічної навігації -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="14,10" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16213A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Картки -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Кнопки -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,2,0,18"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- БІЧНА НАВІГАЦІЙНА ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="PLANORA" Foreground="White" FontSize="20" FontWeight="Bold" Margin="24,24,24,20"/>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Overview" Content="▦  Панель огляду" IsChecked="True" Click="Nav_Click"/>
                    <RadioButton x:Name="NavProjects" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Projects" Content="🗂  Проєкти" Click="Nav_Click"/>
                    <RadioButton x:Name="NavTasks" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Tasks" Content="☰  Список завдань" Click="Nav_Click"/>
                    <RadioButton x:Name="NavCreate" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Create" Content="⊕  Створити завдання" Click="Nav_Click"/>
                    <RadioButton x:Name="NavAnalytics" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Analytics" Content="▮  Аналітика" Click="Nav_Click"/>
                    <RadioButton x:Name="NavReview" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Review" Content="✓  На перевірку" Click="Nav_Click"/>
                    <RadioButton x:Name="NavCalendar" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Calendar" Content="▤  Календар" Click="Nav_Click"/>
                    <RadioButton x:Name="NavMyWork" Style="{StaticResource NavButton}" GroupName="Nav" Tag="MyWork" Content="★  Моя робота" Click="Nav_Click"/>
                    <RadioButton x:Name="NavCollab" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Collab" Content="☺  Співпраця" Click="Nav_Click"/>
                    <RadioButton x:Name="NavActivity" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Activity" Content="⚑  Активності" Click="Nav_Click"/>
                    <RadioButton x:Name="NavCategories" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Categories" Content="◉  Категорії" Click="Nav_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,16">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="Settings" Content="⚙  Налаштування" Click="Nav_Click"/>
                    <TextBlock x:Name="UserNameText" Text="Користувач" Foreground="White" FontWeight="SemiBold" Margin="26,14,12,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- РОБОЧА ОБЛАСТЬ СТОРІНОК (PagesHost) -->
        <Grid Grid.Column="1" x:Name="PagesHost" Margin="28,24">

            <!-- 1. ПАНЕЛЬ ОГЛЯДУ -->
            <Grid x:Name="Page_Overview">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Огляд активностей" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Короткий звіт вашого робочого простору на сьогодні" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <!-- Статистика, що завантажується з бази -->
                <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,18">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Всього завдань" Foreground="#64748B"/>
                            <TextBlock x:Name="StatTotal" Text="0" FontSize="30" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="В роботі" Foreground="#64748B"/>
                            <TextBlock x:Name="StatInProgress" Text="0" FontSize="30" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Виконано" Foreground="#64748B"/>
                            <TextBlock x:Name="StatDone" Text="0" FontSize="30" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Протерміновано" Foreground="#64748B"/>
                            <TextBlock x:Name="StatOverdue" Text="0" FontSize="30" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Найближчі завдання" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                            <ListBox x:Name="UpcomingList" BorderThickness="0" Background="Transparent" DisplayMemberPath="Title"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Background="#FEFCE8" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⚠️ Системне сповіщення" FontWeight="Bold" Foreground="#854D0E" Margin="0,0,0,6"/>
                                <TextBlock Text="Перевірте актуальні дедлайни та статус виконання завдань." TextWrapping="Wrap" FontSize="12" Foreground="#713F12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ПУЛ ПРОЄКТІВ -->
            <Grid x:Name="Page_Projects" Visibility="Collapsed">
                <local:ProjectsView />
            </Grid>

            <!-- 2. СПИСОК ЗАВДАНЬ -->
            <Grid x:Name="Page_Tasks" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Список завдань" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Перегляд, пошук та керування поточними процесами" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="+ Нове завдання" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="GoToCreate_Click"/>
                    <Button DockPanel.Dock="Right" Content="Видалити" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="GoToDelete_Click"/>
                    <Button DockPanel.Dock="Right" Content="Оновити прогрес" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="GoToUpdateProgress_Click"/>
                    <Button DockPanel.Dock="Right" Content="Редагувати" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="GoToEdit_Click"/>
                    <Button DockPanel.Dock="Right" Content="Деталі" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="GoToDetails_Click"/>
                    <TextBox x:Name="SearchBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="SearchBox_TextChanged"/>
                </DockPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <DataGrid x:Name="TasksDataGrid" MouseDoubleClick="TasksDataGrid_MouseDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                              Background="White" RowHeight="48" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="НАЗВА ЗАВДАННЯ" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="ДЕДЛАЙН" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="ПРІОРИТЕТ" Binding="{Binding Priority}" Width="110"/>
                            <DataGridTextColumn Header="СТАТУС" Binding="{Binding Status}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- 3. СТВОРИТИ ЗАВДАННЯ -->
            <ScrollViewer x:Name="Page_Create" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Створення нового завдання" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Заповніть форму для реєстрації завдання в системі Planora" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Проєкт *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ProjectTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Назва завдання *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TitleTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Детальний опис завдання" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DescriptionTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Термін виконання (Дедлайн)" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="DeadlineDatePicker" Height="34"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Пріоритет виконання" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="PriorityComboBox" Height="34" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Високий" Tag="{x:Static enums:TaskPriority.High}"/>
                                        <ComboBoxItem Content="Середній" Tag="{x:Static enums:TaskPriority.Medium}" IsSelected="True"/>
                                        <ComboBoxItem Content="Низький" Tag="{x:Static enums:TaskPriority.Low}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelToTasks_Click"/>
                                <Button Content="Створити та запустити" Style="{StaticResource PrimaryButton}" Click="CreateButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. ДЕТАЛІ ЗАВДАННЯ -->
            <ScrollViewer x:Name="Page_Details" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Деталі завдання" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Повний перегляд вибраного завдання" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="DetailsContainer">
                            <TextBlock x:Name="DetailsTitleText" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                            <TextBlock x:Name="DetailsStatusText" FontSize="14" Foreground="#64748B" Margin="0,0,0,16"/>
                            <TextBlock Text="Опис:" Style="{StaticResource FieldLabel}"/>
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <TextBlock x:Name="DetailsDescriptionText" TextWrapping="Wrap" FontSize="14" Foreground="#334155"/>
                            </Border>
                            <TextBlock x:Name="DetailsDeadlineText" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,20"/>
                            <Button Content="Назад до списку" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="CancelToTasks_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 5. РЕДАГУВАННЯ ЗАВДАННЯ -->
            <ScrollViewer x:Name="Page_Edit" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редагування завдання" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Змініть дані завдання та збережіть" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Назва завдання *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditTitleTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Детальний опис" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditDescriptionTextBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Термін виконання (Дедлайн) *" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="EditDeadlineDatePicker" Height="34"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Пріоритет" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="EditPriorityComboBox" Height="34" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Високий" Tag="{x:Static enums:TaskPriority.High}"/>
                                        <ComboBoxItem Content="Середній" Tag="{x:Static enums:TaskPriority.Medium}"/>
                                        <ComboBoxItem Content="Низький" Tag="{x:Static enums:TaskPriority.Low}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelToTasks_Click"/>
                                <Button Content="Зберегти зміни" Style="{StaticResource PrimaryButton}" Click="SaveEditButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 6. ОНОВЛЕННЯ ПРОГРЕСУ -->
            <ScrollViewer x:Name="Page_UpdateProgress" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Оновлення прогресу завдання" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Зміна статусу виконання завдання" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ідентифікатор завдання (Task ID) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ProgTaskIdTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Ідентифікатор співвиконавця (User ID) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ProgUserIdTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Новий статус *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ProgStatusComboBox" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,20">
                                <ComboBoxItem Content="В роботі" Tag="{x:Static enums:TaskItemStatus.InProgress}" IsSelected="True"/>
                                <ComboBoxItem Content="Виконано" Tag="{x:Static enums:TaskItemStatus.Done}"/>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelToTasks_Click"/>
                                <Button Content="Оновити прогрес" Style="{StaticResource PrimaryButton}" Click="SaveProgressButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 7. ВИДАЛЕННЯ ЗАВДАННЯ -->
            <ScrollViewer x:Name="Page_Delete" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Видалення завдання (Owner)" Style="{StaticResource PageTitle}" Foreground="#EF4444"/>
                    <TextBlock Text="Лише власник (Owner) може видалити дане завдання" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Task ID (Guid завдання) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DelTaskIdTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Current User ID (Guid користувача) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DelUserIdTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,16"/>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                                <TextBlock x:Name="DelStatusText" Text="Очікування підтвердження..." Foreground="#64748B" TextWrapping="Wrap"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelToTasks_Click"/>
                                <Button Content="Підтвердити видалення" Style="{StaticResource DangerButton}" Click="ConfirmDeleteButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 8. АНАЛІТИКА -->
            <Grid x:Name="Page_Analytics" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Панель аналітики" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Аналіз загальної продуктивності та навантаження команди" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="AnTotal" Margin="0,0,0,8"/>
                            <TextBlock x:Name="AnDone" Margin="0,0,0,8"/>
                            <TextBlock x:Name="AnActive" Margin="0,0,0,8"/>
                            <TextBlock x:Name="AnOverdue" Margin="0,0,0,12"/>
                            <ProgressBar x:Name="AnProgress" Height="12" Maximum="100" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ЗАГЛУШКИ ДЛЯ ІНШИХ РОЗДІЛІВ МЕНЮ -->
            <Grid x:Name="Page_Review" Visibility="Collapsed">
                <TextBlock Text="Черга перевірки: у розробці" Style="{StaticResource PageTitle}"/>
            </Grid>
            <Grid x:Name="Page_Calendar" Visibility="Collapsed">
                <TextBlock Text="Календар: у розробці" Style="{StaticResource PageTitle}"/>
            </Grid>
            <Grid x:Name="Page_MyWork" Visibility="Collapsed">
                <TextBlock Text="Моя робота: у розробці" Style="{StaticResource PageTitle}"/>
            </Grid>
            <Grid x:Name="Page_Collab" Visibility="Collapsed">
                <TextBlock Text="Співпраця: у розробці" Style="{StaticResource PageTitle}"/>
            </Grid>
            <Grid x:Name="Page_Activity" Visibility="Collapsed">
                <TextBlock Text="Активності: у розробці" Style="{StaticResource PageTitle}"/>
            </Grid>
            <Grid x:Name="Page_Categories" Visibility="Collapsed">
                <TextBlock Text="Категорії: у розробці" Style="{StaticResource PageTitle}"/>
            </Grid>
            <Grid x:Name="Page_Settings" Visibility="Collapsed">
                <TextBlock Text="Налаштування: у розробці" Style="{StaticResource PageTitle}"/>
            </Grid>

        </Grid>
    </Grid>
</Window>