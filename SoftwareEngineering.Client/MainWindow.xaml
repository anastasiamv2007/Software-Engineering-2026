<Window x:Class="SoftwareEngineering.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:SoftwareEngineering.DAL.Enums;assembly=SoftwareEngineering.DAL"
        xmlns:local="clr-namespace:SoftwareEngineering.Client"
        xmlns:models="clr-namespace:SoftwareEngineering.BLL.Models;assembly=SoftwareEngineering.BLL"
        Title="PLANORA" Height="800" Width="1280" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Window}"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewKeyDown="Window_PreviewKeyDown" Foreground="{DynamicResource Brush.Text}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Стиль кнопок бічної навігації -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="14,10" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SidebarItemActive}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SidebarItemHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Картки -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Кнопки -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,2,0,18"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- БІЧНА НАВІГАЦІЙНА ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="PLANORA" Foreground="White" FontSize="20" FontWeight="Bold" Margin="24,24,24,20"/>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Overview" Content="▦  Панель огляду" IsChecked="True" Click="Nav_Click"/>
                    <RadioButton x:Name="NavProjects" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Projects" Content="🗂  Проєкти" Click="Nav_Click"/>
                    <RadioButton x:Name="NavTasks" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Tasks" Content="☰  Список завдань" Click="Nav_Click"/>
                    <RadioButton x:Name="NavCreate" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Create" Content="⊕  Створити завдання" Click="Nav_Click"/>
                    <RadioButton x:Name="NavAnalytics" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Analytics" Content="▮  Аналітика" Click="Nav_Click"/>
                    <RadioButton x:Name="NavReview" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Review" Content="✓  На перевірку" Click="Nav_Click"/>
                    <RadioButton x:Name="NavCalendar" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Calendar" Content="▤  Календар" Click="Nav_Click"/>
                    <RadioButton x:Name="NavMyWork" Style="{StaticResource NavButton}" GroupName="Nav" Tag="MyWork" Content="★  Моя робота" Click="Nav_Click"/>
                    <RadioButton x:Name="NavCollab" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Collab" Content="☺  Співпраця" Click="Nav_Click"/>
                    <RadioButton x:Name="NavActivity" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Activity" Content="⚑  Активності" Click="Nav_Click"/>
                    <RadioButton x:Name="NavCategories" Style="{StaticResource NavButton}" GroupName="Nav" Tag="Categories" Content="◉  Категорії" Click="Nav_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,16">
                    <Button x:Name="ThemeToggleButton" Content="☾  Темна тема" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.SidebarText}"
                            FontSize="13" Margin="12,2" Padding="14,10" HorizontalContentAlignment="Left" Cursor="Hand"
                            ToolTip="Перемкнути світлу / темну тему" Click="ThemeToggle_Click"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="Settings" Content="⚙  Налаштування" Click="Nav_Click"/>
                    <!-- Обліковий запис: вихід і зміна бази сховані в меню, щоб не натиснути їх випадково -->
                    <Button x:Name="AccountButton" Margin="16,12,16,0" Padding="10" Background="{DynamicResource Brush.SidebarCard}"
                            BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand" ToolTip="Обліковий запис"
                            Click="AccountButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Змінити базу даних" Click="SignOutAndDisconnect_Click"
                                          ToolTip="Вийти та обрати інше підключення до бази даних"/>
                                <Separator/>
                                <MenuItem Header="Вийти з облікового запису" Foreground="{DynamicResource Brush.DangerText}" Click="SignOut_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="⋯" FontSize="16" Foreground="{DynamicResource Brush.SidebarText}" VerticalAlignment="Center"/>
                            <Border CornerRadius="16" Width="32" Height="32" Background="{DynamicResource Brush.Accent}" Margin="0,0,10,0">
                                <TextBlock x:Name="UserInitialsText" Text="?" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText" Text="Користувач" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Активна сесія" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- РОБОЧА ОБЛАСТЬ СТОРІНОК (PagesHost) -->
        <Grid Grid.Column="1" x:Name="PagesHost" Margin="28,24">

            <!-- 1. ПАНЕЛЬ ОГЛЯДУ -->
            <Grid x:Name="Page_Overview">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Огляд активностей" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Короткий звіт вашого робочого простору на сьогодні" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <!-- Статистика, що завантажується з бази -->
                <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,18">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Всього завдань" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock x:Name="StatTotal" Text="0" FontSize="30" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="В роботі" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock x:Name="StatInProgress" Text="0" FontSize="30" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Виконано" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock x:Name="StatDone" Text="0" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Brush.SuccessText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Протерміновано" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock x:Name="StatOverdue" Text="0" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Brush.DangerText}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Найближчі завдання" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                            <ListBox x:Name="UpcomingList" BorderThickness="0" Background="Transparent" DisplayMemberPath="Title"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.WarningSoftBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⚠️ Системне сповіщення" FontWeight="Bold" Foreground="{DynamicResource Brush.WarningSoftText}" Margin="0,0,0,6"/>
                                <TextBlock Text="Перевірте актуальні дедлайни та статус виконання завдань." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.WarningSoftText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ПУЛ ПРОЄКТІВ -->
            <Grid x:Name="Page_Projects" Visibility="Collapsed">
                <local:ProjectsView ProjectsChanged="ProjectsView_ProjectsChanged"/>
            </Grid>

            <!-- 2. СПИСОК ЗАВДАНЬ -->
            <Grid x:Name="Page_Tasks" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Новий рядок для фільтрів -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Список завдань" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Перегляд, пошук та керування поточними процесами" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="+ Нове завдання" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="GoToCreate_Click"/>
                    <Button DockPanel.Dock="Right" Content="Видалити" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="GoToDelete_Click"/>
                    <Button DockPanel.Dock="Right" Content="Оновити прогрес" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="GoToUpdateProgress_Click"/>
                    <Button DockPanel.Dock="Right" Content="Копіювати" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="CopyTask_Click"/>
                    <Button DockPanel.Dock="Right" Content="Редагувати" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="GoToEdit_Click"/>
                    <Button DockPanel.Dock="Right" Content="Деталі" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="GoToDetails_Click"/>
                    <TextBox x:Name="SearchBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="SearchBox_TextChanged"/>
                </DockPanel>

                <!-- ПАНЕЛЬ ФІЛЬТРІВ ТА СОРТУВАННЯ (WrapPanel переносить фільтри на вузькому вікні) -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <WrapPanel Orientation="Horizontal">

                    <!-- Фільтр за статусом -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Статус:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FilterStatusComboBox" Width="130" Height="32" VerticalContentAlignment="Center" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="Всі" IsSelected="True"/>
                            <ComboBoxItem Content="До виконання" Tag="Todo"/>
                            <ComboBoxItem Content="В роботі" Tag="InProgress"/>
                            <ComboBoxItem Content="На перевірці" Tag="InReview"/>
                            <ComboBoxItem Content="На доопрацюванні" Tag="NeedsRevision"/>
                            <ComboBoxItem Content="Виконано" Tag="Done"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Фільтр за пріоритетом -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Пріоритет:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FilterPriorityComboBox" Width="130" Height="32" VerticalContentAlignment="Center" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="Всі" IsSelected="True"/>
                            <ComboBoxItem Content="Високий" Tag="High"/>
                            <ComboBoxItem Content="Середній" Tag="Medium"/>
                            <ComboBoxItem Content="Низький" Tag="Low"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Фільтр за категорією (список заповнюється з БД) -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Категорія:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FilterCategoryComboBox" Width="150" Height="32" VerticalContentAlignment="Center" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="Всі" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Сортування -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Сортувати за:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="SortComboBox" Width="180" Height="32" VerticalContentAlignment="Center" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="Дедлайном (найближчі)" Tag="ByDeadlineAsc" IsSelected="True"/>
                            <ComboBoxItem Content="Пріоритетом (високий → низький)" Tag="ByPriorityDesc"/>
                            <ComboBoxItem Content="Назвою (А-Я)" Tag="ByTitleAsc"/>
                            <ComboBoxItem Content="Статусом (до виконання → виконано)" Tag="ByStatus"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Період за дедлайном: можна задати одну або обидві межі -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Дедлайн з:" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="FilterDeadlineFromPicker" Width="130" Height="32" SelectedDateChanged="OnFilterChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="по:" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="FilterDeadlineToPicker" Width="130" Height="32" SelectedDateChanged="OnFilterChanged"/>
                    </StackPanel>

                    <!-- Тільки прострочені -->
                    <CheckBox x:Name="FilterOverdueCheckBox" Content="Тільки прострочені" 
                              Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,16,8" 
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>

                    <!-- Кнопка скидання -->
                    <Button Content="Скинути" Style="{StaticResource SecondaryButton}" Height="32" Padding="16,0" VerticalAlignment="Bottom" Click="OnClearFiltersClicked"/>
                </WrapPanel>

                <!-- Помилка фільтра (наприклад, «з» пізніше за «по»); список тоді лишається попереднім -->
                <TextBlock x:Name="FilterErrorText" Foreground="{DynamicResource Brush.DangerText}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <local:ClippingBorder Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                    <DataGrid x:Name="TasksDataGrid" MouseDoubleClick="TasksDataGrid_MouseDoubleClick" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                              Background="{DynamicResource Brush.Surface}" RowHeight="48" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="НАЗВА ЗАВДАННЯ" Binding="{Binding Title}" Width="*"/>
                            <DataGridTemplateColumn Header="КАТЕГОРІЯ" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding CategoryColorHex, TargetNullValue=Transparent}"/>
                                            <TextBlock Text="{Binding CategoryName, TargetNullValue='—'}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ДЕДЛАЙН" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="ПРІОРИТЕТ" Binding="{Binding Priority}" Width="110"/>
                            <DataGridTextColumn Header="СТАТУС" Binding="{Binding Status}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </local:ClippingBorder>
            </Grid>

            <!-- 3. СТВОРИТИ ЗАВДАННЯ -->
            <ScrollViewer x:Name="Page_Create" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Створення нового завдання" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Заповніть форму для реєстрації завдання в системі Planora" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Проєкт *" Style="{StaticResource FieldLabel}"/>
                            <!-- Лише проєкти, де користувач може створювати завдання; вписати назву вручну не можна -->
                            <ComboBox x:Name="ProjectComboBox" Height="34" VerticalContentAlignment="Center" DisplayMemberPath="Name" Margin="0,0,0,12"/>
                            <TextBlock x:Name="NoProjectsHint" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.WarningText}" Margin="0,-6,0,12"
                                       Text="Немає проєктів, у яких ви можете створювати завдання. Створіть проєкт на вкладці «Проєкти» або попросіть власника додати вас співвиконавцем."/>

                            <TextBlock Text="Назва завдання *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TitleTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Детальний опис завдання" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DescriptionTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Термін виконання (Дедлайн)" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="DeadlineDatePicker" Height="34"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Пріоритет виконання" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="PriorityComboBox" Height="34" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Високий" Tag="{x:Static enums:TaskPriority.High}"/>
                                        <ComboBoxItem Content="Середній" Tag="{x:Static enums:TaskPriority.Medium}" IsSelected="True"/>
                                        <ComboBoxItem Content="Низький" Tag="{x:Static enums:TaskPriority.Low}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Категорія" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CategoryComboBox" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelToTasks_Click"/>
                                <Button x:Name="CreateTaskButton" Content="Створити та запустити" Style="{StaticResource PrimaryButton}" Click="CreateButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. ДЕТАЛІ ЗАВДАННЯ -->
            <ScrollViewer x:Name="Page_Details" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Деталі завдання" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Повний перегляд вибраного завдання" Style="{StaticResource PageSubtitle}"/>
                    <!-- Заголовок: код, назва, статус, пріоритет -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel x:Name="DetailsContainer">
                            <TextBlock x:Name="DetailsCodeText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DetailsTitleText" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="DetailsBadges"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button x:Name="CopyDescriptionButton" DockPanel.Dock="Right" Content="Копіювати" Style="{StaticResource SecondaryButton}"
                                                Padding="10,3" FontSize="12" ToolTip="Скопіювати весь опис у буфер обміну" Click="CopyDescription_Click"/>
                                        <TextBlock Text="Опис" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                                    </DockPanel>
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="8">
                                        <!-- RichTextBox лише для читання: текст можна виділити й скопіювати (Ctrl+C), посилання клікабельні -->
                                        <RichTextBox x:Name="DetailsDescriptionBox" IsReadOnly="True" IsDocumentEnabled="True"
                                                     BorderThickness="0" Background="Transparent" FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}"
                                                     VerticalScrollBarVisibility="Disabled" IsUndoEnabled="False"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Підзадачі (чек-лист): права приходять із TaskDetailsModel -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Підзадачі" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="DetailsSubtasksText" FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,6"/>
                                    <ProgressBar x:Name="DetailsSubtasksProgress" Height="8" Maximum="100" Margin="0,0,0,12"/>

                                    <!-- Tag списку — видимість кнопки видалення (лише автор завдання або власник проєкту) -->
                                    <ItemsControl x:Name="DetailsSubtasksList" Tag="{x:Static Visibility.Collapsed}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="24" Padding="0"
                                                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.DangerText}" Cursor="Hand"
                                                            ToolTip="Видалити підзадачу" Tag="{Binding Id}" Click="DeleteSubtask_Click"
                                                            Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                    <!-- Click, а не Checked: спрацьовує лише від дії користувача, не під час завантаження списку -->
                                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Tag="{Binding Id}" Click="SubtaskCheckBox_Click"
                                                              VerticalAlignment="Center" VerticalContentAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" Margin="4,0,0,0"/>
                                                    </CheckBox>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid x:Name="DetailsAddSubtaskPanel" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewSubtaskTitleTextBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,8,0"
                                                 MaxLength="200" KeyDown="NewSubtaskTitleTextBox_KeyDown"/>
                                        <Button Grid.Column="1" Content="Додати" Style="{StaticResource PrimaryButton}" Click="AddSubtask_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Коментарі: від старіших до новіших; ✕ видно лише автору коментаря та власнику проєкту -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="DetailsCommentsText" Text="Коментарі" Style="{StaticResource FieldLabel}"/>

                                    <ListBox x:Name="DetailsCommentsList" Background="Transparent" BorderThickness="0" MaxHeight="300"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="22" Padding="0" VerticalAlignment="Top"
                                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.DangerText}" Cursor="Hand"
                                                                ToolTip="Видалити коментар" Tag="{Binding Id}" Click="DeleteComment_Click"
                                                                Visibility="{Binding DeleteVisibility}"/>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" FontSize="12" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Grid x:Name="DetailsAddCommentPanel">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewCommentTextBox" Height="54" TextWrapping="Wrap" AcceptsReturn="True" Padding="8"
                                                 MaxLength="1000" VerticalScrollBarVisibility="Auto" FontSize="13" Foreground="{DynamicResource Brush.Text}"/>
                                        <Button x:Name="SendCommentButton" Grid.Column="1" Content="Надіслати" Style="{StaticResource PrimaryButton}"
                                                Margin="8,0,0,0" VerticalAlignment="Bottom" Click="SendComment_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Учасники проєкту" Style="{StaticResource FieldLabel}"/>
                                    <ItemsControl x:Name="DetailsMembersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,6">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Role}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                                                        <TextBlock Text="{Binding Email}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- Довідкова інформація: заповнюється з коду рядками «назва — значення» -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Інформація" Style="{StaticResource FieldLabel}"/>
                                <Grid x:Name="DetailsInfoGrid" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Назад до списку" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelToTasks_Click"/>
                        <Button x:Name="DetailsEditButton" Content="Редагувати" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="GoToEdit_Click"/>
                        <Button x:Name="DetailsCopyButton" Content="Копіювати" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CopyTask_Click"/>
                        <Button x:Name="DetailsSubmitReviewButton" Content="Відправити на перевірку" Style="{StaticResource PrimaryButton}" Background="{DynamicResource Brush.Success}" Click="SubmitForReview_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 5. РЕДАГУВАННЯ ЗАВДАННЯ -->
            <ScrollViewer x:Name="Page_Edit" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редагування завдання" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Змініть дані завдання та збережіть" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Назва завдання *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditTitleTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Детальний опис" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="EditDescriptionTextBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Padding="8" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Термін виконання (Дедлайн) *" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="EditDeadlineDatePicker" Height="34"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Пріоритет" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="EditPriorityComboBox" Height="34" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Високий" Tag="{x:Static enums:TaskPriority.High}"/>
                                        <ComboBoxItem Content="Середній" Tag="{x:Static enums:TaskPriority.Medium}"/>
                                        <ComboBoxItem Content="Низький" Tag="{x:Static enums:TaskPriority.Low}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Категорія" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="EditCategoryComboBox" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Виконавець" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="EditAssigneeComboBox" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>
                           

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelToTasks_Click"/>
                                <Button Content="Зберегти зміни" Style="{StaticResource PrimaryButton}" Click="SaveEditButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 6. ОНОВЛЕННЯ ПРОГРЕСУ -->
            <ScrollViewer x:Name="Page_UpdateProgress" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Оновлення прогресу завдання" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Зміна статусу виконання завдання" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ідентифікатор завдання (Task ID) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ProgTaskIdTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Ідентифікатор співвиконавця (User ID) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ProgUserIdTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Новий статус *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ProgStatusComboBox" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,20">
                                <ComboBoxItem Content="В роботі" Tag="{x:Static enums:TaskItemStatus.InProgress}" IsSelected="True"/>
                                <ComboBoxItem Content="Виконано" Tag="{x:Static enums:TaskItemStatus.Done}"/>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelToTasks_Click"/>
                                <Button Content="Оновити прогрес" Style="{StaticResource PrimaryButton}" Click="SaveProgressButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 7. ВИДАЛЕННЯ ЗАВДАННЯ -->
            <ScrollViewer x:Name="Page_Delete" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Видалення завдання (Owner)" Style="{StaticResource PageTitle}" Foreground="{DynamicResource Brush.DangerText}"/>
                    <TextBlock Text="Лише власник (Owner) може видалити дане завдання" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Task ID (Guid завдання) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DelTaskIdTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <TextBlock Text="Current User ID (Guid користувача) *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DelUserIdTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,16"/>

                            <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                                <TextBlock x:Name="DelStatusText" Text="Очікування підтвердження..." Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelToTasks_Click"/>
                                <Button Content="Підтвердити видалення" Style="{StaticResource DangerButton}" Click="ConfirmDeleteButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 8. АНАЛІТИКА -->
            <Grid x:Name="Page_Analytics" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Панель аналітики" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Аналіз загальної продуктивності та навантаження команди" Style="{StaticResource PageSubtitle}"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Завершено вчасно" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="AnProgress" Height="12" Maximum="100" Foreground="{DynamicResource Brush.Success}"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Rows="1">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Загальна кількість" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"/>
                                <TextBlock x:Name="AnTotal" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Виконані" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"/>
                                <TextBlock x:Name="AnDone" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SuccessText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Активні" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"/>
                                <TextBlock x:Name="AnActive" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Протерміновані" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"/>
                                <TextBlock x:Name="AnOverdue" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Grid>
            <!-- ЗАГЛУШКИ ДЛЯ ІНШИХ РОЗДІЛІВ МЕНЮ -->
            <!-- 9. ЧЕРГА ПЕРЕВІРКИ -->
            <Grid x:Name="Page_Review" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Оновити чергу" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Click="RefreshReviewQueue_Click"/>
                    <StackPanel>
                        <TextBlock Text="Черга перевірки" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Завдання проєктів, у яких ви є власником або рецензентом (Читачем)" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <local:ClippingBorder Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="ReviewQueueDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                                  Background="{DynamicResource Brush.Surface}" RowHeight="48" CanUserAddRows="False"
                                  SelectionChanged="ReviewQueueDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="КОД" Binding="{Binding TaskCode}" Width="85"/>
                                <DataGridTextColumn Header="НАЗВА ЗАВДАННЯ" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="ПРІОРИТЕТ" Binding="{Binding Priority}" Width="105"/>
                                <DataGridTextColumn Header="ДЕДЛАЙН" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy HH:mm}" Width="135"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </local:ClippingBorder>

                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Рішення рецензента" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="ReviewSelectedTitleText" Text="Оберіть завдання зі списку ліворуч" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                                <TextBlock x:Name="ReviewSelectedDescriptionText" Text="Опис вибраного завдання з'явиться тут." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="Коментар (обов'язково для повернення на доопрацювання)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ReviewCommentTextBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Padding="8"
                                     MaxLength="1000" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ReviewRequestRevisionButton" Content="Повернути на доопрацювання" Style="{StaticResource DangerButton}" Margin="0,0,8,0" IsEnabled="False" Click="RequestRevision_Click"/>
                                <Button x:Name="ReviewApproveButton" Content="Прийняти (Done)" Style="{StaticResource PrimaryButton}" Background="{DynamicResource Brush.Success}" IsEnabled="False" Click="ApproveReview_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            <!-- КАЛЕНДАР: дедлайни завдань по днях місяця -->
            <Grid x:Name="Page_Calendar" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="◀" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" ToolTip="Попередній місяць" Click="CalendarPrevMonth_Click"/>
                        <Button Content="Сьогодні" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="CalendarToday_Click"/>
                        <Button Content="▶" Style="{StaticResource SecondaryButton}" ToolTip="Наступний місяць" Click="CalendarNextMonth_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="CalendarMonthTitle" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Дедлайни ваших завдань. Клацніть день, щоб побачити список; подвійний клік по завданню відкриває деталі." Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0" Rows="1" Columns="7" Margin="0,0,0,6">
                                <TextBlock Text="Пн" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="Вт" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="Ср" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="Чт" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="Пт" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="Сб" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextFaint}"/>
                                <TextBlock Text="Нд" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextFaint}"/>
                            </UniformGrid>

                            <ItemsControl Grid.Row="1" x:Name="CalendarDaysControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="6" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CalendarDayModel}">
                                        <Border x:Name="Cell" Margin="2" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                                Background="{DynamicResource Brush.Surface}" Padding="6,4" Cursor="Hand" MouseLeftButtonUp="CalendarDay_Click">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Ellipse x:Name="OverdueDot" DockPanel.Dock="Right" Width="8" Height="8" Fill="{DynamicResource Brush.Danger}"
                                                             VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Є прострочені завдання"/>
                                                    <TextBlock x:Name="DayNumber" Text="{Binding Day}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding PreviewTasks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="Chip" Background="{DynamicResource Brush.AccentSubtle}" CornerRadius="4" Padding="4,1" Margin="0,2,0,0">
                                                                <TextBlock x:Name="ChipText" Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource Brush.AccentSoftText}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:TaskItemStatus.Done}">
                                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Brush.TextFaint}"/>
                                                                    <Setter TargetName="ChipText" Property="TextDecorations" Value="Strikethrough"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock x:Name="MoreText" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0"
                                                           Text="{Binding HiddenTasksCount, StringFormat='+{0} ще'}"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.Window}"/>
                                                <Setter TargetName="Cell" Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                            <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                            </Trigger>
                                            <!-- Обраний день — світло-блакитний фон; рамка «сьогодні» лишається окремо -->
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                <Setter TargetName="Cell" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="DayNumber" Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                <Setter TargetName="OverdueDot" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HiddenTasksCount}" Value="0">
                                                <Setter TargetName="MoreText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock x:Name="CalendarSelectedDayTitle" DockPanel.Dock="Top" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="CalendarNoTasksText" DockPanel.Dock="Top" Text="На цей день дедлайнів немає." Foreground="{DynamicResource Brush.TextMuted}" Visibility="Collapsed"/>
                            <ListBox x:Name="CalendarDayTasksList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="CalendarDayTasks_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}">
                                                    <Run Text="{Binding Code, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Time, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Status, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap"/>
                                                <TextBlock Text="Прострочено" Foreground="{DynamicResource Brush.DangerText}" FontSize="11"
                                                           Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="Page_MyWork" Visibility="Collapsed">
                <TextBlock Text="Моя робота: у розробці" Style="{StaticResource PageTitle}"/>
            </Grid>
            <Grid x:Name="Page_Collab" Visibility="Collapsed">
                <TextBlock Text="Співпраця: у розробці" Style="{StaticResource PageTitle}"/>
            </Grid>
            <Grid x:Name="Page_Activity" Visibility="Collapsed">
                <TextBlock Text="Активності: у розробці" Style="{StaticResource PageTitle}"/>
            </Grid>
            <Grid x:Name="Page_Categories" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Керування категоріями" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Організовуйте ваші завдання за функціональними напрямками" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Категорії" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                            <ListBox x:Name="CatList" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" SelectionChanged="CatList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="12" Height="12" Fill="{Binding ColorHex}" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TasksCount, StringFormat={}{0} завдань}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock x:Name="CatHeader" Text="Створити категорію" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

                            <TextBlock Text="Назва категорії *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CatName" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="100" TextChanged="CatName_TextChanged"/>

                            <TextBlock Text="Колір маркера" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <WrapPanel x:Name="CatPalette"/>

                            <TextBlock Text="Попередній перегляд" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <Border Background="{DynamicResource Brush.AccentSubtle}" BorderBrush="{DynamicResource Brush.AccentSoftBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="CatPreviewDot" Width="12" Height="12" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="CatPreviewText" Text="Поки що без назви"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="CatError" Foreground="{DynamicResource Brush.DangerText}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button x:Name="CatDeleteButton" Content="Видалити" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="CatDelete_Click"/>
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CatCancel_Click"/>
                                <Button x:Name="CatSaveButton" Content="Додати категорію" Style="{StaticResource PrimaryButton}" Click="CatSave_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            <!-- НАЛАШТУВАННЯ: профіль, пароль, тема -->
            <ScrollViewer x:Name="Page_Settings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                    <TextBlock Text="Налаштування" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Особисті дані облікового запису, пароль і вигляд програми" Style="{StaticResource PageSubtitle}"/>

                    <!-- Профіль: ім'я та email -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border CornerRadius="24" Width="48" Height="48" Background="{DynamicResource Brush.Accent}" Margin="0,0,14,0">
                                    <TextBlock x:Name="ProfileAvatarText" Text="?" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileHeaderNameText" Text="Користувач" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock x:Name="ProfileMetaText" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Повне ім'я *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ProfileFullNameTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="150" Margin="0,0,0,12"/>

                            <TextBlock Text="Електронна пошта *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ProfileEmailTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="255" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Скасувати" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ResetProfileForm_Click"/>
                                <Button x:Name="SaveProfileButton" Content="Зберегти зміни" Style="{StaticResource PrimaryButton}" Click="SaveProfile_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Зміна пароля -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Зміна пароля" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="«Запам'ятати мене» на цьому комп'ютері залишиться, а на інших пристроях доведеться увійти з новим паролем."
                                       FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <TextBlock Text="Поточний пароль *" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="OldPasswordBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Новий пароль (мін. 6 символів) *" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="NewPasswordBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Підтвердження нового пароля *" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="ConfirmPasswordBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ChangePasswordButton" Content="Змінити пароль" Style="{StaticResource PrimaryButton}" Click="ChangePassword_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Тема оформлення -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Тема оформлення" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                            <!-- Tag — назва теми з AppTheme; код просто перебирає ці перемикачі -->
                            <StackPanel x:Name="ThemeOptions">
                                <RadioButton GroupName="Theme" Tag="System" Content="Як у Windows (світла або сіра темна)" Margin="0,0,0,8" Checked="ThemeRadio_Checked"/>
                                <RadioButton GroupName="Theme" Tag="Light" Content="Світла" Margin="0,0,0,8" Checked="ThemeRadio_Checked"/>
                                <RadioButton GroupName="Theme" Tag="Dark" Content="Темна сіра (як у VS Code)" Margin="0,0,0,8" Checked="ThemeRadio_Checked"/>
                                <RadioButton GroupName="Theme" Tag="Black" Content="Чорна" Margin="0,0,0,8" Checked="ThemeRadio_Checked"/>
                                <RadioButton GroupName="Theme" Tag="DarkBlue" Content="Темно-синя" Margin="0,0,0,8" Checked="ThemeRadio_Checked"/>
                            </StackPanel>
                            <TextBlock Text="Вибір запам'ятовується для вашого користувача Windows і діє в усіх вікнах програми."
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>