<Window x:Class="SoftwareEngineering.Client.DuplicateTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Копіювання завдання" Height="427" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Border Margin="20" Padding="20" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
        <StackPanel>
            <TextBlock Text="Копіювання завдання" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock x:Name="SourceText" FontSize="12" Foreground="#64748B" Margin="0,4,0,16" TextWrapping="Wrap"/>

            <TextBlock Text="Назва копії *" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="TitleTextBox" Height="34" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0" MaxLength="200"/>

            <TextBlock Text="Дедлайн *" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
            <DatePicker x:Name="DeadlinePicker" Height="34" Margin="0,4,0,12"/>

            <CheckBox x:Name="CopySubtasksCheckBox" Content="Копіювати підзадачі (без відміток про виконання)" IsChecked="True"
                      Foreground="#334155" Margin="0,0,0,6"/>
            <TextBlock Text="Опис, пріоритет і категорія копіюються; коментарі, виконавець і статус — ні."
                       FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Скасувати" Width="100" Height="34" Margin="0,0,8,0" Background="White" BorderBrush="#CBD5E1" Click="CancelButton_Click"/>
                <Button x:Name="CreateButton" Content="Створити копію" Width="140" Height="34" Background="#2563EB" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold" Click="CreateButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
