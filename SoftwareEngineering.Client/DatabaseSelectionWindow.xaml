<Window x:Class="SoftwareEngineering.Client.DatabaseSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLANORA — Вибір бази даних" Height="560" Width="560" MinHeight="460" MinWidth="480"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#EF4444"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="PLANORA" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Оберіть базу даних для підключення" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
            <Grid>
                <ListBox x:Name="ConnectionsList" BorderThickness="0" Background="Transparent" Margin="6"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="ConnectionsList_SelectionChanged"
                         MouseDoubleClick="ConnectionsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                                               Text="{Binding LastUsedAt, StringFormat='Останнє підключення: {0:dd.MM.yyyy HH:mm}', TargetNullValue='Ще не підключались'}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Збережених баз ще немає" FontSize="14" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                    <TextBlock Text="Додайте першу кнопкою «+ Нова база»" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#64748B" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap"/>

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="AddButton" DockPanel.Dock="Left" Content="+ Нова база" Style="{StaticResource SecondaryButton}" Click="AddButton_Click"/>
            <Button x:Name="EditButton" DockPanel.Dock="Left" Content="Редагувати" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Content="Видалити" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteButton_Click"/>
            <Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="Підключитися" Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
