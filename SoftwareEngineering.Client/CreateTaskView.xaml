<Window x:Class="SoftwareEngineering.Client.CreateTaskView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:SoftwareEngineering.DAL.Enums;assembly=SoftwareEngineering.DAL"
        Title="Створення нового завдання" Height="560" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Проєкт -->
        <TextBlock Grid.Row="0" Text="Проєкт *" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" x:Name="ProjectTextBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

        <!-- Назва завдання -->
        <TextBlock Grid.Row="2" Text="Назва завдання *" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" x:Name="TitleTextBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

        <!-- Опис -->
        <TextBlock Grid.Row="4" Text="Детальний опис" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="5" x:Name="DescriptionTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

        <!-- Дедлайн -->
        <TextBlock Grid.Row="6" Text="Термін виконання (Дедлайн) *" FontWeight="Bold" Margin="0,0,0,5"/>
        <DatePicker Grid.Row="7" x:Name="DeadlineDatePicker" Height="30" Margin="0,0,0,10"/>

        <!-- Пріоритет -->
        <TextBlock Grid.Row="8" Text="Пріоритет" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="9" x:Name="PriorityComboBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15">
            <ComboBoxItem Content="Високий" Tag="{x:Static enums:TaskPriority.High}"/>
            <ComboBoxItem Content="Середній" Tag="{x:Static enums:TaskPriority.Medium}" IsSelected="True"/>
            <ComboBoxItem Content="Низький" Tag="{x:Static enums:TaskPriority.Low}"/>
        </ComboBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Скасувати" Width="90" Height="30" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Створити" Width="110" Height="30" Click="CreateButton_Click" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>