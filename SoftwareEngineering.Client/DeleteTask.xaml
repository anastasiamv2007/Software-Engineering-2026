<Window x:Class="SoftwareEngineering.Client.DeleteTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoftwareEngineering.Client"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Delete Task" Height="450" Width="800">
    <StackPanel Margin="30">
        <!-- Заголовок -->
        <TextBlock Text="Тестове вікно: Видалення завдання (Owner)" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="#F38BA8" 
                   Margin="0,0,0,8"/>

        <TextBlock Text="Перевірка бізнес-правила: лише Власник (Owner) може видалити таску." 
                   FontSize="12" 
                   Foreground="#A6ADC8" 
                   Margin="0,0,0,25"/>

        <!-- Поле вводу Task ID -->
        <TextBlock Text="Task ID (Guid завдання):" Foreground="#CDD6F4" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="TaskIdTextBox" 
                 Height="35" 
                 Padding="8,6" 
                 Background="#313244" 
                 Foreground="#CDD6F4" 
                 BorderBrush="#45475A" 
                 FontSize="13"
                 Margin="0,0,0,15"/>

        <!-- Поле вводу User ID -->
        <TextBlock Text="Current User ID (Guid користувача, що видаляє):" Foreground="#CDD6F4" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="UserIdTextBox" 
                 Height="35" 
                 Padding="8,6" 
                 Background="#313244" 
                 Foreground="#CDD6F4" 
                 BorderBrush="#45475A" 
                 FontSize="13"
                 Margin="0,0,0,20"/>

        <!-- Кнопка тесту -->
        <Button Content="Виконати Use Case: Видалити" 
                Height="40" 
                Background="#F38BA8" 
                Foreground="#11111B" 
                FontWeight="Bold" 
                FontSize="14" 
                BorderThickness="0" 
                Cursor="Hand"
                Click="DeleteButton_Click"
                Margin="0,0,0,20"/>

        <!-- Результат тесту -->
        <TextBlock Text="Результат виконання (Log / Status):" Foreground="#A6ADC8" Margin="0,0,0,5"/>
        <Border Background="#11111B" CornerRadius="5" Padding="10" MinHeight="60">
            <TextBlock x:Name="StatusTextBlock" 
                       Text="Очікування вводу даних..." 
                       Foreground="#BAC2DE" 
                       TextWrapping="Wrap" 
                       FontFamily="Consolas"/>
        </Border>
    </StackPanel>
</Window>
