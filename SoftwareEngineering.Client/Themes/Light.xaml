<!--
    Світла палітра. Ключі однакові з Dark.xaml, Black.xaml і DarkBlue.xaml: розмітка посилається на них через DynamicResource,
    тож ThemeManager просто підміняє словник, і всі вікна перемальовуються без перезапуску.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Поверхні -->
    <SolidColorBrush x:Key="Brush.Window" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.Neutral" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#CBD5E1"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="Brush.Text" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#64748B"/>
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#94A3B8"/>

    <!-- Акцент (кнопки, посилання, обраний день) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Brush.AccentSoftBorder" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="Brush.AccentSoftText" Color="#1E40AF"/>

    <!-- Стани -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#EF4444"/>
    <SolidColorBrush x:Key="Brush.DangerText" Color="#EF4444"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="Brush.DangerSoftBorder" Color="#FECACA"/>
    <SolidColorBrush x:Key="Brush.DangerSoftText" Color="#991B1B"/>

    <SolidColorBrush x:Key="Brush.Success" Color="#10B981"/>
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#10B981"/>

    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706"/>
    <SolidColorBrush x:Key="Brush.WarningText" Color="#B45309"/>
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FEFCE8"/>
    <SolidColorBrush x:Key="Brush.WarningSoftBorder" Color="#FEF08A"/>
    <SolidColorBrush x:Key="Brush.WarningSoftText" Color="#854D0E"/>

    <!-- Бічне меню темне в усіх темах -->
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.SidebarItemActive" Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.SidebarItemHover" Color="#16213A"/>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#CBD5E1"/>
</ResourceDictionary>
