<!--
    Темна сіра палітра в дусі стандартної Dark теми VS Code: нейтральні сірі без синього відтінку.
    Ті самі ключі, що й у Light.xaml. Основний текст #D4D4D4 на картці #252526 — контраст ~11:1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Поверхні -->
    <SolidColorBrush x:Key="Brush.Window" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#252526"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#2D2D30"/>
    <SolidColorBrush x:Key="Brush.Neutral" Color="#3A3A3D"/>
    <SolidColorBrush x:Key="Brush.Input" Color="#313131"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#505054"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="Brush.Text" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#9D9D9D"/>
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#727272"/>

    <!-- Акцент: кнопки й виділення як у VS Code -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#0E639C"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#3794FF"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#264F78"/>
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#1E3A52"/>
    <SolidColorBrush x:Key="Brush.AccentSoftBorder" Color="#2F6FA8"/>
    <SolidColorBrush x:Key="Brush.AccentSoftText" Color="#9CDCFE"/>

    <!-- Стани -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Brush.DangerText" Color="#F48771"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#3F1D1D"/>
    <SolidColorBrush x:Key="Brush.DangerSoftBorder" Color="#7A2E2E"/>
    <SolidColorBrush x:Key="Brush.DangerSoftText" Color="#F4A6A0"/>

    <SolidColorBrush x:Key="Brush.Success" Color="#16825D"/>
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#89D185"/>

    <SolidColorBrush x:Key="Brush.Warning" Color="#9A6700"/>
    <SolidColorBrush x:Key="Brush.WarningText" Color="#CCA700"/>
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#3A3214"/>
    <SolidColorBrush x:Key="Brush.WarningSoftBorder" Color="#6E5C1E"/>
    <SolidColorBrush x:Key="Brush.WarningSoftText" Color="#E2C08D"/>

    <!-- Бічне меню -->
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#181818"/>
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#252526"/>
    <SolidColorBrush x:Key="Brush.SidebarItemActive" Color="#37373D"/>
    <SolidColorBrush x:Key="Brush.SidebarItemHover" Color="#2A2D2E"/>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#CCCCCC"/>
</ResourceDictionary>
