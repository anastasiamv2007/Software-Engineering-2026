<!--
    Чорна палітра: майже чорний фон, як у темних темах більшості IDE.
    Ті самі ключі, що й у Light.xaml. Основний текст #E6E6E6 на картці #141414 — контраст ~15:1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Поверхні -->
    <SolidColorBrush x:Key="Brush.Window" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#141414"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Brush.Neutral" Color="#262626"/>
    <SolidColorBrush x:Key="Brush.Input" Color="#0F0F0F"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#262626"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3A3A3A"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="Brush.Text" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#6B6B6B"/>

    <!-- Акцент -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#6CA8FF"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1A2B45"/>
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#111D30"/>
    <SolidColorBrush x:Key="Brush.AccentSoftBorder" Color="#24406B"/>
    <SolidColorBrush x:Key="Brush.AccentSoftText" Color="#A8C8FF"/>

    <!-- Стани -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="Brush.DangerText" Color="#FF7B72"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#2A0F0F"/>
    <SolidColorBrush x:Key="Brush.DangerSoftBorder" Color="#5C1D1D"/>
    <SolidColorBrush x:Key="Brush.DangerSoftText" Color="#FFA198"/>

    <SolidColorBrush x:Key="Brush.Success" Color="#15803D"/>
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#4ADE80"/>

    <SolidColorBrush x:Key="Brush.Warning" Color="#B45309"/>
    <SolidColorBrush x:Key="Brush.WarningText" Color="#F0B429"/>
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#2A2108"/>
    <SolidColorBrush x:Key="Brush.WarningSoftBorder" Color="#5E4A12"/>
    <SolidColorBrush x:Key="Brush.WarningSoftText" Color="#F5D58A"/>

    <!-- Бічне меню -->
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#000000"/>
    <SolidColorBrush x:Key="Brush.SidebarCard" Color="#141414"/>
    <SolidColorBrush x:Key="Brush.SidebarItemActive" Color="#222222"/>
    <SolidColorBrush x:Key="Brush.SidebarItemHover" Color="#191919"/>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#C8C8C8"/>
</ResourceDictionary>
