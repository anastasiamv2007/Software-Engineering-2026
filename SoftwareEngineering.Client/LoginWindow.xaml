<Window x:Class="SoftwareEngineering.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLANORA — Авторизація" Height="500" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}">
    <Border Padding="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PLANORA" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="HeaderSubtitle" Text="Вхід у систему" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,20" HorizontalAlignment="Center"/>

            <!-- Поле для імені (потрібне лише при реєстрації) -->
            <StackPanel x:Name="FullNameBlock" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="Ім'я та Прізвище" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                <TextBox x:Name="FullNameBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center" Padding="8,0"/>
            </StackPanel>

            <TextBlock Text="Електронна пошта" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <TextBox x:Name="EmailBox" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <TextBlock Text="Пароль" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <PasswordBox x:Name="PasswordBox" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <!-- Вхід зберігається лише для цієї бази і цього користувача Windows (DPAPI) -->
            <CheckBox x:Name="RememberMeCheckBox" Content="Запам'ятати мене на цьому пристрої" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16"
                      ToolTip="Наступного разу програма відкриється одразу, без логіну. Кнопка «Вийти» скасовує збережений вхід."/>

            <Button x:Name="SubmitButton" Content="Увійти в кабінет" Height="40" Background="{DynamicResource Brush.Accent}" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="0,0,0,12" Click="SubmitButton_Click"/>

            <Button x:Name="SwitchModeButton" Content="Немає акаунту? Зареєструватися" Background="Transparent" Foreground="{DynamicResource Brush.AccentText}" BorderThickness="0" Cursor="Hand" Click="SwitchModeButton_Click"/>
        </StackPanel>
    </Border>
</Window>