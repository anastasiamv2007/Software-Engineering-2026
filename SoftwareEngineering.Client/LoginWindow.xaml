<Window x:Class="SoftwareEngineering.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLANORA — Авторизація" Height="500" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FFFFFF">
    <Border Padding="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PLANORA" FontSize="28" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
            <TextBlock x:Name="HeaderSubtitle" Text="Вхід у систему" FontSize="14" Foreground="#64748B" Margin="0,4,0,20" HorizontalAlignment="Center"/>

            <!-- Поле для імені (потрібне лише при реєстрації) -->
            <StackPanel x:Name="FullNameBlock" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="Ім'я та Прізвище" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="FullNameBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center" Padding="8,0"/>
            </StackPanel>

            <TextBlock Text="Електронна пошта" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="EmailBox" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <TextBlock Text="Пароль" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
            <PasswordBox x:Name="PasswordBox" Height="36" Margin="0,4,0,20" VerticalContentAlignment="Center" Padding="8,0"/>

            <Button x:Name="SubmitButton" Content="Увійти в кабінет" Height="40" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="0,0,0,12" Click="SubmitButton_Click"/>

            <Button x:Name="SwitchModeButton" Content="Немає акаунту? Зареєструватися" Background="Transparent" Foreground="#2563EB" BorderThickness="0" Cursor="Hand" Click="SwitchModeButton_Click"/>
        </StackPanel>
    </Border>
</Window>