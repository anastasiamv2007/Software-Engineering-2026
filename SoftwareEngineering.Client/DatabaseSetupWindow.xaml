<Window x:Class="SoftwareEngineering.Client.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLANORA — З'єднання з PostgreSQL" Height="660" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}">
    <Border Padding="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PLANORA" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="HeaderSubtitle" Text="Нове підключення до бази даних" FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,25" HorizontalAlignment="Center"/>

            <TextBlock Text="Назва підключення (для списку)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <TextBox x:Name="NameBox" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <TextBlock Text="Хост (IP сервера або Tailscale)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <TextBox x:Name="HostBox" Text="localhost" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <TextBlock Text="Порт" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <TextBox x:Name="PortBox" Text="5432" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <TextBlock Text="Назва бази даних" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <TextBox x:Name="DatabaseBox" Text="planora_db" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <TextBlock Text="Користувач (Username)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <TextBox x:Name="UserBox" Text="postgres" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <TextBlock Text="Пароль (зберігається зашифрованим)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <PasswordBox x:Name="PasswordBox" Height="36" Margin="0,4,0,20" VerticalContentAlignment="Center" Padding="8,0"/>

            <Button x:Name="TestButton" Content="Тестувати з'єднання" Height="36" Margin="0,0,0,10" Background="{DynamicResource Brush.Neutral}" Foreground="{DynamicResource Brush.Text}" BorderThickness="0" FontWeight="SemiBold" Click="TestConnection_Click"/>
            <Button x:Name="SaveButton" Content="Зберегти" Height="40" Background="{DynamicResource Brush.Accent}" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>
    </Border>
</Window>
