<Window x:Class="SoftwareEngineering.Client.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLANORA — З'єднання з PostgreSQL" Height="600" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F8FAFC">
    <Border Padding="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PLANORA" FontSize="26" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
            <TextBlock Text="Налаштування локальної або віддаленої БД" FontSize="13" Foreground="#64748B" Margin="0,4,0,25" HorizontalAlignment="Center"/>

            <TextBlock Text="Хост (IP сервера або Tailscale)" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="HostBox" Text="localhost" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <TextBlock Text="Порт" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="PortBox" Text="5432" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <TextBlock Text="Назва бази даних" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="DatabaseBox" Text="planora_db" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <TextBlock Text="Користувач (Username)" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
            <TextBox x:Name="UserBox" Text="postgres" Height="36" Margin="0,4,0,12" VerticalContentAlignment="Center" Padding="8,0"/>

            <TextBlock Text="Пароль" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
            <PasswordBox x:Name="PasswordBox" Height="36" Margin="0,4,0,20" VerticalContentAlignment="Center" Padding="8,0"/>

            <Button Content="Тестувати з'єднання" Height="36" Margin="0,0,0,10" Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0" FontWeight="SemiBold" Click="TestConnection_Click"/>
            <Button Content="Зберегти та продовжити" Height="40" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="SaveAndContinue_Click"/>
        </StackPanel>
    </Border>
</Window>